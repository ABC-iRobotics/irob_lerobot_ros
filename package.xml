<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>irob_lerobot_ros</name>
  <version>0.0.0</version>
  <description>LeRobot ROS 2 integration package.</description>
  <maintainer email="makany.andras@uni-obuda.hu">Andras Makany</maintainer>
  <license>GPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- ros2robot.py imports pymoveit2 at module level, so every consumer of this
       package needs it built; without the dependency a "packages up to guide"
       colcon build silently leaves it out. -->
  <exec_depend>pymoveit2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
